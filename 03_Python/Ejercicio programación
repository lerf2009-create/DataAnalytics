def validar_operacion(unidades, precio, descuento, estado, prometidos):

    valido = True

    if unidades <= 0:
        valido = False

    if precio <= 0:
        valido = False

    if descuento < 0 or descuento > 40:
        valido = False

    if estado != "Entregado" and estado != "Pendiente" and estado != "Cancelado":
